{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hunchmemory.dev" }],
      "destination": "https://www.hunchmemory.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.hunchmemory.dev" }],
      "destination": "https://www.hunchmemory.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hunch-pi.vercel.app" }],
      "destination": "https://www.hunchmemory.com/:path*",
      "permanent": true
    }
  ]
}
